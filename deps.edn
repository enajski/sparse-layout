{:paths ["src"]
 :aliases
 {:test {:extra-paths ["test"]
         :main-opts ["-e" "(do (require 'clojure.test 'sparse-layout.core-test 'sparse-layout.facade-test 'sparse-layout.csr-source-test) (let [{:keys [fail error]} (clojure.test/run-tests 'sparse-layout.core-test 'sparse-layout.facade-test 'sparse-layout.csr-source-test)] (when (pos? (+ fail error)) (System/exit 1))))"]}
  :clerk {:extra-paths ["notebooks"]
          :extra-deps {io.github.nextjournal/clerk {:mvn/version "0.18.1158"}}
          :exec-fn nextjournal.clerk/serve!
          :exec-args {:watch-paths ["notebooks" "src"]
                      :browse false}}
  :clerk/build {:exec-fn nextjournal.clerk/build!
                :exec-args {:paths ["notebooks/sparse_layout/csr_source_notebook.clj"]}}
  :bench {:extra-paths ["bench"]
          :extra-deps {criterium/criterium {:mvn/version "0.5.243-ALPHA"}
                       net.mikera/vectorz-clj {:mvn/version "0.48.0"}}
          :jvm-opts ["-XX:+UnlockExperimentalVMOptions"
                     "-XX:CompileCommand=blackhole,criterium.blackhole.Blackhole::consume"]
          :main-opts ["-m" "sparse-layout.bench"]}
  :construct {:extra-paths ["bench"]
              :extra-deps {criterium/criterium {:mvn/version "0.5.243-ALPHA"}}
              :jvm-opts ["-XX:+UnlockExperimentalVMOptions"
                         "-XX:CompileCommand=blackhole,criterium.blackhole.Blackhole::consume"]
              :main-opts ["-m" "sparse-layout.construct"]}
  :memory {:extra-paths ["bench"]
           :extra-deps {com.clojure-goes-fast/clj-memory-meter {:mvn/version "0.4.0"}
                        net.mikera/vectorz-clj {:mvn/version "0.48.0"}}
           :jvm-opts ["-XX:+EnableDynamicAgentLoading"
                      "-Djdk.attach.allowAttachSelf=true"]
           :main-opts ["-m" "sparse-layout.memory"]}}}
